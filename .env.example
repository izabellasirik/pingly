# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (required) ---------------------------------------------------
# Local: printed by `npm run db:start`. Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the reminder scheduler and account deletion.
SUPABASE_SECRET_KEY=

# Public URL of the app (used in auth emails and reminder emails). Read at runtime.
APP_URL=http://localhost:3000

# --- Reminder scheduler (required for email reminders) ---------------------
# Any long random string. The cron caller sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- AI (optional — without it, Ask AI is disabled; everything else works) -
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
# PINGLY_AI_MODEL=

# --- Email reminders (optional — without them, reminders show in-app only) -
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Pingly <reminders@yourdomain.com>"
REMINDER_EMAIL_FROM=
